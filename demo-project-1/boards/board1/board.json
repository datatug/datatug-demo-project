{
  "id": "board1",
  "title": "Chinook customer insights",
  "tags": [
    "chinook",
    "sales",
    "customers"
  ],
  "access": "public",
  "rows": [
    {
      "cards": [
        {
          "id": "top-customer-spend",
          "title": "Top customer spend",
          "cols": 6,
          "widget": {
            "name": "chart",
            "data": {
              "title": "Top customer spend \u00b7 amounts in cents",
              "sources": [
                {
                  "id": "top-customer-spend-rows",
                  "queryId": "demodb/chinook-top-customer-spend"
                }
              ],
              "chart": {
                "type": "bar",
                "categoryColumn": "CustomerName",
                "valueColumn": "TotalCents",
                "unit": "cents"
              },
              "defaultView": "grid"
            }
          }
        },
        {
          "id": "playlist-composition",
          "title": "Playlist composition",
          "cols": 6,
          "widget": {
            "name": "chart",
            "data": {
              "title": "Tracks per playlist ID \u00b7 names are available in Source rows",
              "sources": [
                {
                  "id": "playlist-composition-rows",
                  "queryId": "demodb/chinook-playlist-composition"
                }
              ],
              "chart": {
                "type": "bar",
                "categoryColumn": "PlaylistId",
                "valueColumn": "TrackCount",
                "unit": "tracks"
              },
              "defaultView": "grid"
            }
          }
        }
      ]
    }
  ]
}
