{
  "id": "northwind",
  "title": "Northwind operations",
  "tags": [
    "northwind",
    "sales",
    "operations"
  ],
  "access": "public",
  "rows": [
    {
      "cards": [
        {
          "id": "reorder-watchlist",
          "title": "Reorder watchlist",
          "cols": 6,
          "widget": {
            "name": "chart",
            "data": {
              "title": "Stock against reorder level \u00b7 public Northwind SQLite",
              "sources": [
                {
                  "id": "reorder-watchlist-rows",
                  "queryId": "demodb/northwind-reorder-watchlist"
                }
              ],
              "chart": {
                "type": "bar",
                "categoryColumn": "ProductName",
                "unit": "units",
                "series": [
                  {
                    "id": "in-stock",
                    "title": "In stock",
                    "valueColumn": "UnitsInStock"
                  },
                  {
                    "id": "reorder-level",
                    "title": "Reorder level",
                    "valueColumn": "ReorderLevel"
                  }
                ]
              },
              "defaultView": "grid"
            }
          }
        },
        {
          "id": "top-customer-orders",
          "title": "Top customer orders",
          "cols": 6,
          "widget": {
            "name": "chart",
            "data": {
              "title": "Top customer sales \u00b7 amounts in cents",
              "sources": [
                {
                  "id": "top-customer-orders-rows",
                  "queryId": "demodb/northwind-top-customer-orders"
                }
              ],
              "chart": {
                "type": "bar",
                "categoryColumn": "CompanyName",
                "valueColumn": "SalesCents",
                "unit": "cents"
              },
              "defaultView": "grid"
            }
          }
        }
      ]
    }
  ]
}
