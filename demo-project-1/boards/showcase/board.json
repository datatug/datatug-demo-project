{
  "id": "showcase",
  "title": "Orders in motion \u00b7 DataTug visual showcase",
  "access": "public",
  "rows": [
    {
      "cards": [
        {
          "id": "orders-by-month-country",
          "title": "Where Northwind orders shipped \u00b7 month by month",
          "cols": 12,
          "widget": {
            "name": "chart",
            "data": {
              "title": "830 orders \u00b7 July 2016\u2013May 2018 \u00b7 shipping country",
              "sources": [
                {
                  "id": "northwind-orders",
                  "queryId": "demodb/northwind-orders-browser-sqlite",
                  "transform": {
                    "name": "orders-monthly-country-count",
                    "orderIdColumn": "OrderID",
                    "dateColumn": "OrderDate",
                    "countryColumn": "ShipCountry"
                  }
                }
              ],
              "chart": {
                "type": "bar-race",
                "categoryColumn": "category",
                "valueColumn": "value",
                "periodColumn": "period",
                "unit": "orders",
                "grain": "month",
                "onDuplicate": "reject",
                "mode": "period",
                "topN": 10
              },
              "defaultView": "chart"
            }
          }
        }
      ]
    },
    {
      "cards": [
        {
          "id": "northwind-shipping-countries",
          "title": "Northwind orders by shipping country",
          "cols": 6,
          "widget": {
            "name": "chart",
            "data": {
              "title": "Order count by destination \u00b7 Northwind SQLite",
              "sources": [
                {
                  "id": "northwind-country-counts",
                  "queryId": "demodb/northwind-country-counts-browser-sqlite"
                }
              ],
              "chart": {
                "type": "bar",
                "categoryColumn": "ShipCountry",
                "valueColumn": "orders",
                "unit": "orders"
              },
              "defaultView": "chart"
            }
          }
        },
        {
          "id": "source-inspector",
          "title": "Inspect three saved query results",
          "cols": 6,
          "widget": {
            "name": "tabs",
            "data": {
              "tabs": [
                {
                  "id": "sqlite-orders",
                  "title": "Northwind \u00b7 SQLite orders",
                  "widget": {
                    "name": "SQL",
                    "data": {
                      "title": "Inspect the complete 14-field Orders projection used by the race.",
                      "sql": {
                        "queryId": "demodb/northwind-orders-browser-sqlite"
                      }
                    }
                  }
                },
                {
                  "id": "sqlite-countries",
                  "title": "Northwind \u00b7 SQLite countries",
                  "widget": {
                    "name": "SQL",
                    "data": {
                      "title": "Inspect all 21 shipping-country counts from the same pinned Northwind SQLite snapshot.",
                      "sql": {
                        "queryId": "demodb/northwind-country-counts-browser-sqlite"
                      }
                    }
                  }
                },
                {
                  "id": "chinook-customers",
                  "title": "Chinook \u00b7 customer billing",
                  "widget": {
                    "name": "SQL",
                    "data": {
                      "title": "Chinook invoice totals in cents from its own pinned SQLite dataset.",
                      "sql": {
                        "queryId": "demodb/chinook-billing-browser-sqlite"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
