{
  "id": "showcase",
  "title": "Orders in motion · DataTug visual showcase",
  "tags": [
    "northwind",
    "chinook",
    "customers"
  ],
  "access": "public",
  "rows": [
    {
      "cards": [
        {
          "id": "orders-by-month-country",
          "title": "Where Northwind orders shipped · month by month",
          "cols": 12,
          "widget": {
            "name": "chart",
            "data": {
              "title": "830 orders · July 2016–May 2018 · shipping country",
              "sources": [
                {
                  "id": "northwind-orders",
                  "queryId": "demodb/northwind-orders-full-sqlite",
                  "transform": {
                    "name": "orders-monthly-country-count",
                    "orderIdColumn": "OrderID",
                    "dateColumn": "OrderDate",
                    "countryColumn": "ShipCountry"
                  }
                }
              ],
              "chart": {
                "type": "bar-race",
                "categoryColumn": "category",
                "valueColumn": "value",
                "periodColumn": "period",
                "unit": "orders",
                "grain": "month",
                "onDuplicate": "reject",
                "mode": "period",
                "topN": 10
              },
              "defaultView": "chart"
            }
          }
        }
      ]
    },
    {
      "cards": [
        {
          "id": "northwind-shipping-countries",
          "title": "Northwind orders by shipping country",
          "cols": 6,
          "widget": {
            "name": "chart",
            "data": {
              "title": "Order count by destination · Northwind server",
              "sources": [
                {
                  "id": "northwind-country-counts",
                  "queryId": "demodb/northwind-shipping-country-count-sqlite"
                }
              ],
              "chart": {
                "type": "bar",
                "categoryColumn": "ShipCountry",
                "valueColumn": "orders",
                "unit": "orders"
              },
              "defaultView": "chart"
            }
          }
        },
        {
          "id": "shared-customer-countries",
          "title": "Customer records by shared country",
          "cols": 6,
          "widget": {
            "name": "chart",
            "data": {
              "title": "Northwind + Chinook · customer records, not shared people · exact labels; UK/nulls excluded.",
              "sources": [
                {
                  "id": "shared-country-counts",
                  "queryId": "demodb/customer-country-comparison-server"
                }
              ],
              "chart": {
                "type": "bar",
                "categoryColumn": "country",
                "unit": "customer records",
                "selectionId": "customer-country",
                "series": [
                  {
                    "id": "northwind",
                    "title": "Northwind",
                    "valueColumn": "northwindCustomers"
                  },
                  {
                    "id": "chinook",
                    "title": "Chinook",
                    "valueColumn": "chinookCustomers"
                  }
                ]
              },
              "defaultView": "chart"
            }
          }
        }
      ]
    },
    {
      "cards": [
        {
          "id": "customer-country-sources",
          "title": "Customer records by country · independent sources",
          "cols": 12,
          "widget": {
            "name": "chart",
            "data": {
              "title": "Customer records · nulls excluded: fixture 2026-10-21 Northwind 2, Chinook 0; live data may change.",
              "sources": [
                {
                  "id": "northwind",
                  "queryId": "demodb/northwind-customer-country-counts-server"
                },
                {
                  "id": "chinook",
                  "queryId": "demodb/chinook-customer-country-counts-server"
                }
              ],
              "chart": {
                "type": "bar",
                "categoryColumn": "country",
                "valueColumn": "customers",
                "unit": "customer records"
              },
              "defaultView": "chart"
            }
          }
        }
      ]
    },
    {
      "cards": [
        {
          "id": "source-inspector",
          "title": "Inspect saved query results",
          "cols": 12,
          "widget": {
            "name": "tabs",
            "data": {
              "tabs": [
                {
                  "id": "sqlite-orders",
                  "title": "Northwind · server orders",
                  "widget": {
                    "name": "SQL",
                    "data": {
                      "title": "Verified Orders · country selection filters shipping destinations, not customer-to-order matches.",
                      "sql": {
                        "queryId": "demodb/northwind-orders-full-sqlite",
                        "presentationFilter": {
                          "selectionId": "customer-country",
                          "column": "ShipCountry"
                        }
                      }
                    }
                  }
                },
                {
                  "id": "sqlite-countries",
                  "title": "Northwind · server countries",
                  "widget": {
                    "name": "chart",
                    "data": {
                      "title": "Inspect all 21 shipping-country counts from an independent live Northwind server query.",
                      "sources": [
                        {
                          "id": "sqlite-countries-rows",
                          "queryId": "demodb/northwind-country-counts-server"
                        }
                      ],
                      "chart": {
                        "type": "bar",
                        "categoryColumn": "ShipCountry",
                        "valueColumn": "orders",
                        "unit": "orders"
                      },
                      "defaultView": "grid"
                    }
                  }
                },
                {
                  "id": "shared-customer-countries",
                  "title": "Northwind + Chinook · shared countries",
                  "widget": {
                    "name": "chart",
                    "data": {
                      "title": "Customer records, not shared people · exact shared labels; UK variants and nulls excluded.",
                      "sources": [
                        {
                          "id": "shared-customer-countries-rows",
                          "queryId": "demodb/customer-country-comparison-server"
                        }
                      ],
                      "chart": {
                        "type": "bar",
                        "categoryColumn": "country",
                        "unit": "customer records",
                        "series": [
                          {
                            "id": "northwind",
                            "title": "Northwind",
                            "valueColumn": "northwindCustomers"
                          },
                          {
                            "id": "chinook",
                            "title": "Chinook",
                            "valueColumn": "chinookCustomers"
                          }
                        ]
                      },
                      "defaultView": "grid"
                    }
                  }
                },
                {
                  "id": "chinook-customers",
                  "title": "Chinook · customer billing",
                  "widget": {
                    "name": "chart",
                    "data": {
                      "title": "Chinook invoice totals in currency units from its read-only server dataset.",
                      "sources": [
                        {
                          "id": "chinook-customers-rows",
                          "queryId": "demodb/chinook-billing-server"
                        }
                      ],
                      "chart": {
                        "type": "bar",
                        "categoryColumn": "CustomerId",
                        "valueColumn": "Total",
                        "unit": "currency units"
                      },
                      "defaultView": "grid"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
