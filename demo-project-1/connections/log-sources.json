{
  "format": "datatug-log-sources/v1",
  "sources": [
    {
      "id": "shipping-logs",
      "title": "Shipping logs",
      "database": "https://ovdb.demodb.dev/v1/databases/shipping-logs",
      "synthetic": true,
      "collections": [
        { "id": "baseline", "title": "Shipping events" },
        {
          "id": "carrierGateway",
          "title": "Carrier gateway calls",
          "fields": { "correlation": "correlation_id", "service": "stream" }
        }
      ],
      "fields": {
        "timestamp": "occurred_at",
        "sequence": "sequence",
        "message": "kind",
        "reference": "event_id"
      },
      "identifiers": [
        { "field": "order_id", "label": "Order ID", "param": "order", "type": "integer" },
        { "field": "attempt_id", "label": "Attempt ID", "param": "attempt", "type": "string" }
      ],
      "window": { "from": "2018-04-01T00:00:00Z", "to": "2018-05-21T00:00:00Z" },
      "records": [
        { "database": "https://ovdb.demodb.dev/v1/databases/northwind", "collection": "Orders", "field": "OrderID", "param": "order" },
        { "database": "https://ovdb.demodb.dev/v1/databases/shipping", "collection": "requests", "field": "order_id", "param": "order" },
        { "database": "https://ovdb.demodb.dev/v1/databases/shipping", "collection": "attempts", "field": "attempt_id", "param": "attempt" }
      ]
    },
    {
      "id": "northwind-local",
      "title": "Northwind evidence (local agent)",
      "database": "http://127.0.0.1:6832/v1/databases/northwind_evidence",
      "synthetic": true,
      "collections": [
        { "id": "fulfillment_events", "title": "Fulfillment events" },
        { "id": "carrier_events", "title": "Carrier events" }
      ],
      "fields": {
        "timestamp": "timestamp",
        "severity": "severity",
        "service": "service",
        "origin": "source",
        "message": "message",
        "correlation": "correlation_id",
        "reference": "source_ref",
        "raw": "raw",
        "parser": "parser",
        "parseStatus": "parse_status",
        "structured": "fields_json"
      },
      "identifiers": [
        { "field": "order_id", "label": "Order ID", "param": "order", "type": "string" }
      ],
      "window": { "from": "2018-04-21T09:12:00Z", "to": "2018-04-21T09:14:00Z" },
      "records": []
    }
  ]
}
