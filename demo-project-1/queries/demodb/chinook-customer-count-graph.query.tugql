parameters (
  @CustomerId integer required
)
with CustomerCounts as (
  from Invoice as i
  where i.CustomerId = @CustomerId
  group by i.CustomerId
  having count(*) >= 7
  limit 100
  select (
    i.CustomerId
    count(*) as InvoiceCount
  )
)
with EligibleCounts as (
  from CustomerCounts as counts
  where counts.InvoiceCount >= 7
  limit 100
  select (
    counts.CustomerId
    counts.InvoiceCount
  )
)
with CustomerFields as (
  from Customer as c
  order by c.CustomerId asc
  limit 100
  select (
    c.CustomerId
    c.FirstName
    c.LastName
    c.Email
  )
)
from EligibleCounts as totals
join CustomerFields as customer
  on totals.CustomerId = customer.CustomerId
order by totals.CustomerId asc
limit 10
select (
  totals.CustomerId
  totals.InvoiceCount
  customer.FirstName
  customer.LastName
  customer.Email
)
