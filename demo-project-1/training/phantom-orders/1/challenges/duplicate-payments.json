  "hints": [
    {
      "id": "filter-successes",
      "text": "Filter to succeeded payment events first."
    },
    {
      "id": "having-groups",
      "text": "Use HAVING to keep only order groups with more than one success."
    },
    {
      "id": "failed-retry",
      "text": "A failed attempt followed by one success is a recovered retry, not a duplicate charge."
    },
    {
      "id": "failure",
      "text": "Check whether every counted row really represents a successful charge."
    }
  ],
  "referenceSolutions": [
    {
      "partId": "duplicate-payments",
      "answer": {
        "sql": "SELECT order_id, COUNT(*) AS successful_count\nFROM payments\nWHERE status='succeeded'\nGROUP BY order_id\nHAVING COUNT(*)>1;\n"
      }
    }
  ]
