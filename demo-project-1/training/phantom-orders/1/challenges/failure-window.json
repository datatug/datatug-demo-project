  "hints": [
    {
      "id": "second-success",
      "text": "Rank successful events per order and look at the second one."
    },
    {
      "id": "observation",
      "text": "The earliest observation is not proof of the exact defect introduction time."
    },
    {
      "id": "ordering",
      "text": "Use deterministic (created_at, id) ordering for ties."
    }
  ],
  "referenceSolutions": [
    {
      "partId": "failure-window",
      "answer": {
        "sql": "WITH ranked AS (\n  SELECT order_id,created_at,ROW_NUMBER() OVER(PARTITION BY order_id ORDER BY created_at,id) AS n\n  FROM payments\n  WHERE status='succeeded'\n)\nSELECT MIN(created_at) AS first_duplicate_at\nFROM ranked\nWHERE n=2;\n"
      }
    },
    {
      "partId": "interpretation",
      "answer": {
        "structured": {
          "selections": {
            "interpretation": [
              "first-observed-duplicate"
            ]
          }
        }
      }
    }
