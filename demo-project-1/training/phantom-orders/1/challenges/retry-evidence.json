  "hints": [
    {
      "id": "attempt-id",
      "text": "Correlate retry_events to payments by attempt_id, then group by request_id."
    },
    {
      "id": "harmless",
      "text": "r3 has two attempts but only one successful payment; it is a recovered failure."
    },
    {
      "id": "pairing",
      "text": "Select the two duplicate request pairs and their matching trace attachments."
    }
  ],
  "referenceSolutions": [
    {
      "partId": "requests",
      "answer": {
        "sql": "SELECT r.request_id,COUNT(*) AS successes\nFROM retry_events r\nJOIN payments p ON p.attempt_id=r.attempt_id\nWHERE p.status='succeeded'\nGROUP BY r.request_id\nHAVING COUNT(*)>1;\n"
      }
    },
    {
      "partId": "requests-evidence",
      "answer": {
        "structured": {
          "selections": {
            "requests-evidence": [
              "trace-r2",
              "trace-r4"
            ]
          }
        }
      }
    }
  ]
