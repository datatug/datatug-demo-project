  "hints": [
    {
      "id": "null-keys",
      "text": "The duplicate request cohort is the set with NULL idempotency keys and more than one success."
    },
    {
      "id": "correlation",
      "text": "Deployment proximity alone is correlation; the reviewed diff and both traces are required."
    },
    {
      "id": "refute",
      "text": "Ask what evidence would refute the explanation, and do not treat a4's failure as the cause."
    }
  ],
  "referenceSolutions": [
    {
      "partId": "cohort",
      "answer": {
        "sql": "WITH duplicate_requests AS (\n  SELECT r.request_id\n  FROM retry_events r\n  JOIN payments p ON p.attempt_id=r.attempt_id\n  WHERE p.status='succeeded' AND r.idempotency_key IS NULL\n  GROUP BY r.request_id\n  HAVING COUNT(*)>1\n)\nSELECT request_id FROM duplicate_requests;\n"
      }
    },
